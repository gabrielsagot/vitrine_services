---
import Icon from '../Icon.astro';
import { personas } from '../../lib/personas';
import { pitch } from '../../config/site';

interface Props {
  referrer?: { name: string } | null;
}

const { referrer } = Astro.props;

// Contour « cousu » autour du téléphone (même proportions que le cadre en CSS).
const stitch =
  'M166 4H272A56 56 0 0 1 328 60V608A56 56 0 0 1 272 664H60A56 56 0 0 1 4 608V60A56 56 0 0 1 60 4Z';
---

<section class="hero" aria-labelledby="hero-title">
  <div class="wrap hero-grid">
    <div class="hero-copy">
      {referrer && (
        <aside class="referral-card hero-in" style="--i:0" aria-label="Recommandation personnelle">
          <span class="referral-avatar" aria-hidden="true">
            {referrer.name.charAt(0)}
          </span>
          <div class="referral-content">
            <div class="referral-tag">
              <span class="referral-tag-dot" aria-hidden="true" />
              <span>Recommandé par {referrer.name}</span>
            </div>
            <p class="referral-title">
              <em>{referrer.name}</em> pense que je peux vous aider.
            </p>
            <p class="referral-note">Le devis est offert et sans engagement.</p>
          </div>
        </aside>
      )}
      <p class="eyebrow hero-in" style="--i:0">
        Applications sur mesure
      </p>
      <h1 id="hero-title" class="hero-title">
        <span class="line">
          <span class="hero-in" style="--i:1">
            Votre quotidien,
          </span>
        </span>
        <span class="line">
          <em class="hero-in" style="--i:2">
            sur mesure.
          </em>
        </span>
      </h1>
      <p class="hero-sub hero-in" style="--i:3">
        {pitch.subtitle}
      </p>
      <div class="hero-cta hero-in" style="--i:4">
        <a class="btn" href="#contact" data-cta="hero">
          <span>{pitch.cta}</span>
          <svg class="btn-icon" viewBox="0 0 20 20" width="17" height="17" aria-hidden="true">
            <path
              d="M4 10h12M11 5l5 5-5 5"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </a>
        <p class="cta-note">
          <Icon name="check" size={18} stroke={2} /> {pitch.ctaNote}
        </p>
      </div>
    </div>

    <div class="hero-visual hero-in" style="--i:2" data-personas>
      <div class="phone-stage">
        <span class="fil-a" data-fil="10" aria-hidden="true"></span>
        <span class="fil-a fil-m fil-hero-exit" data-fil="11" aria-hidden="true"></span>
        <span class="fil-a fil-d fil-hero-exit-d" data-fil="11" aria-hidden="true"></span>
        <svg class="stitch" viewBox="0 0 332 668" aria-hidden="true" focusable="false">
          <defs>
            <mask id="stitch-mask" maskUnits="userSpaceOnUse" x="-10" y="-10" width="352" height="688">
              <path
                class="stitch-reveal"
                d={stitch}
                pathLength="1"
                fill="none"
                stroke="#fff"
                stroke-width="8"
              ></path>
            </mask>
          </defs>
          <path id="stitch-path" class="stitch-line" d={stitch} mask="url(#stitch-mask)"></path>
          <g class="stitch-needle">
            <circle r="6.5"></circle>
            <g class="needle-eyes">
              <ellipse cx="-2.2" cy="-0.3" rx="1" ry="1.5"></ellipse>
              <ellipse cx="2.2" cy="-0.3" rx="1" ry="1.5"></ellipse>
            </g>
            <animateMotion
              dur="1.4s"
              begin="indefinite"
              fill="freeze"
              calcMode="spline"
              keyTimes="0;1"
              keyPoints="0;1"
              keySplines="0.45 0 0.2 1"
            >
              <mpath href="#stitch-path"></mpath>
            </animateMotion>
          </g>
        </svg>

        <div class="phone">
          <div class="phone-screen">
            <div class="status" aria-hidden="true">
              <span>9:41</span>
              <span class="status-icons">
                <i></i>
                <i></i>
                <b></b>
              </span>
            </div>
            {personas.map((p, i) => (
              <article
                class:list={['persona', `f-${p.font}`, { 'is-active': i === 0 }]}
                data-persona={p.id}
                aria-hidden={i === 0 ? 'false' : 'true'}
                style={`--accent:${p.accent};--accent-soft:${p.soft}`}
              >
                <div class="app-bar" style="--d:0">
                  <span class="app-icon">{p.app.charAt(0)}</span>
                  <span class="app-name">{p.app}</span>
                  <span class="app-avatar">{p.person.charAt(0)}</span>
                </div>
                <p class="greet" style="--d:1">
                  Bonjour {p.person}
                </p>
                <p class="date" style="--d:1">
                  {p.date}
                </p>
                <ul class="stats" style="--d:2">
                  {p.stats.map((s) => (
                    <li>{s}</li>
                  ))}
                </ul>
                <p class="label" style="--d:3">
                  Aujourd'hui
                </p>
                <ol class="agenda">
                  {p.agenda.map((a, k) => (
                    <li style={`--d:${3 + k}`}>
                      <span class="a-time">{a.time}</span>
                      <span class="a-dot" />
                      <span class="a-body">
                        <strong>{a.title}</strong>
                        <small>{a.who}</small>
                      </span>
                      <span class="a-meta">{a.meta}</span>
                    </li>
                  ))}
                </ol>
                <p class="hint" style="--d:8">
                  <Icon name={p.hint.icon} size={18} stroke={1.9} />
                  <span>{p.hint.text}</span>
                </p>
                <nav class="tabs" style="--d:8" aria-hidden="true">
                  <span class="is-on">
                    <Icon name="home" size={19} />
                  </span>
                  <Icon name="calendar" size={19} />
                  <Icon name="users" size={19} />
                  <Icon name="settings" size={19} />
                </nav>
              </article>
            ))}
          </div>
        </div>
      </div>

      <div class="persona-tabs" role="group" aria-label="Exemples d'applications sur mesure">
        {personas.map((p, i) => (
          <button
            type="button"
            class:list={['persona-tab', { 'is-active': i === 0 }]}
            data-persona-tab={p.id}
            aria-pressed={i === 0 ? 'true' : 'false'}
            style={`--accent:${p.accent}`}
          >
            <span class="tab-dot" aria-hidden="true" />
            {p.person}
          </button>
        ))}
      </div>
      <p class="persona-caption" aria-live="polite">
        {personas.map((p, i) => (
          <span class:list={['caption', { 'is-active': i === 0 }]} data-caption={p.id}>
            L'application de {p.person}, {p.job}.
          </span>
        ))}
      </p>
    </div>
  </div>
  <span class="fil-a fil-m fil-gut" data-fil="12" style="bottom:150px" aria-hidden="true"></span>
  <span class="fil-a fil-m fil-gut" data-fil="13" style="bottom:20px" aria-hidden="true"></span>
  <span class="fil-a fil-d fil-hero-knot" data-fil="12" data-fil-ring="16" aria-hidden="true"></span>
  <span class="fil-a fil-d fil-seam-l" data-fil="13" style="bottom:30px" aria-hidden="true"></span>
</section>

<script>
  import { prefersReduced } from '../../lib/tier';

  const root = document.querySelector<HTMLElement>('[data-personas]');
  if (root) {
    const ids = [...root.querySelectorAll<HTMLElement>('[data-persona]')].map((el) => el.dataset['persona']!);
    const needle = root.querySelector<SVGAnimationElement>('.stitch-needle animateMotion');
    const stage = root.querySelector<HTMLElement>('.phone-stage')!;
    let current = 0;
    let timer = 0;
    let visible = true;
    let pausedUntil = 0;

    const sew = () => {
      stage.classList.remove('is-sewing');
      void stage.offsetWidth;
      stage.classList.add('is-sewing');
      try {
        needle?.beginElement();
      } catch {
        /* SMIL indisponible : la couture reste statique */
      }
    };

    const show = (index: number) => {
      current = (index + ids.length) % ids.length;
      const id = ids[current]!;
      root.querySelectorAll<HTMLElement>('[data-persona]').forEach((el) => {
        const on = el.dataset['persona'] === id;
        el.classList.toggle('is-active', on);
        el.setAttribute('aria-hidden', on ? 'false' : 'true');
      });
      root.querySelectorAll<HTMLButtonElement>('[data-persona-tab]').forEach((b) => {
        const on = b.dataset['personaTab'] === id;
        b.classList.toggle('is-active', on);
        b.setAttribute('aria-pressed', on ? 'true' : 'false');
      });
      root.querySelectorAll<HTMLElement>('[data-caption]').forEach((c) => {
        c.classList.toggle('is-active', c.dataset['caption'] === id);
      });
      if (!prefersReduced()) sew();
    };

    const schedule = () => {
      window.clearTimeout(timer);
      if (prefersReduced()) return;
      timer = window.setTimeout(() => {
        if (visible && document.visibilityState === 'visible' && Date.now() > pausedUntil) show(current + 1);
        schedule();
      }, 6200);
    };

    root.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-persona-tab]');
      if (!btn) return;
      pausedUntil = Date.now() + 14000;
      show(ids.indexOf(btn.dataset['personaTab']!));
    });

    if ('IntersectionObserver' in window) {
      new IntersectionObserver((entries) => {
        visible = entries.some((e) => e.isIntersecting);
      }).observe(root);
    }

    // Sur ordinateur, le téléphone s'incline doucement vers la souris, comme une carte posée sur la table.
    const hero = root.closest<HTMLElement>('.hero');
    if (hero && !prefersReduced() && window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
      let frame = 0;
      hero.addEventListener('pointermove', (e) => {
        if (frame) return;
        frame = requestAnimationFrame(() => {
          frame = 0;
          const r = stage.getBoundingClientRect();
          const x = Math.max(-1, Math.min(1, (e.clientX - (r.left + r.width / 2)) / (r.width * 1.6)));
          const y = Math.max(-1, Math.min(1, (e.clientY - (r.top + r.height / 2)) / (r.height * 1.2)));
          stage.style.setProperty('--ry', `${(x * 7).toFixed(2)}deg`);
          stage.style.setProperty('--rx', `${(-y * 5).toFixed(2)}deg`);
        });
      });
      hero.addEventListener('pointerleave', () => {
        stage.style.setProperty('--ry', '0deg');
        stage.style.setProperty('--rx', '0deg');
      });
    }

    const start = () => {
      if (!prefersReduced()) window.setTimeout(sew, 450);
      schedule();
    };
    if (document.readyState === 'complete') start();
    else window.addEventListener('load', start, { once: true });
  }
</script>

<style>
  .hero {
    position: relative;
    padding: 6px 0 72px;
  }

  .hero::before {
    /* Papier de patron : une grille très légère autour du téléphone */
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image:
      linear-gradient(to right, rgb(22 33 62 / 0.055) 1px, transparent 1px),
      linear-gradient(to bottom, rgb(22 33 62 / 0.055) 1px, transparent 1px);
    background-size: 28px 28px;
    -webkit-mask-image: radial-gradient(ellipse 60% 48% at 50% 72%, #000 20%, transparent 75%);
    mask-image: radial-gradient(ellipse 60% 48% at 50% 72%, #000 20%, transparent 75%);
  }

  .hero-grid {
    position: relative;
    z-index: 2;
    display: grid;
    gap: 44px;
  }

  .referral-card {
    display: flex;
    align-items: center;
    gap: 16px;
    margin: 4px 0 24px;
    padding: 14px 18px;
    border-radius: 18px;
    background: var(--paper);
    border: 1px solid var(--line-strong);
    box-shadow:
      0 1px 2px rgb(22 33 62 / 0.04),
      0 8px 24px -10px rgb(22 33 62 / 0.1);
  }

  .referral-avatar {
    flex: none;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: var(--night);
    color: var(--cream);
    display: grid;
    place-items: center;
    font-family: var(--serif);
    font-size: 22px;
    font-weight: 400;
    line-height: 1;
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.12);
  }

  .referral-content {
    flex: 1;
    min-width: 0;
  }

  .referral-tag {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 11.5px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--amber-ink);
  }

  .referral-tag-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--amber);
  }

  .referral-title {
    margin: 2px 0;
    font-family: var(--serif);
    font-size: clamp(20px, 4vw, 24px);
    line-height: 1.25;
    color: var(--night);
    letter-spacing: -0.01em;
  }

  .referral-title em {
    font-style: italic;
    font-weight: 400;
  }

  .referral-note {
    margin: 0;
    font-size: 13.5px;
    color: var(--slate);
    line-height: 1.4;
  }

  @media (max-width: 600px) {
    .referral-card {
      gap: 13px;
      padding: 12px 14px;
      border-radius: 16px;
      margin-bottom: 20px;
    }

    .referral-avatar {
      width: 36px;
      height: 36px;
      font-size: 19px;
    }

    .referral-title {
      font-size: 18.5px;
    }

    .referral-note {
      font-size: 13px;
    }
  }

  .hero-title {
    margin: 18px 0 0;
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(56px, 16.5vw, 112px);
    line-height: 0.94;
    letter-spacing: -0.025em;
  }

  .hero-title .line {
    display: block;
    overflow: hidden;
    padding-bottom: 0.06em;
  }

  .hero-title .line > * {
    display: inline-block;
  }

  .hero-title em {
    font-style: italic;
  }

  .hero-sub {
    margin: 22px 0 0;
    max-width: 22em;
    font-size: clamp(19px, 4.8vw, 22px);
    line-height: 1.45;
    color: var(--slate);
    text-wrap: pretty;
  }

  .hero-cta {
    margin-top: 30px;
  }

  .cta-note {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 14px 0 0;
    font-size: 15px;
    color: var(--slate);
  }

  .cta-note :global(svg) {
    color: var(--amber-ink);
    flex: none;
  }

  /* Entrée : chaque bloc monte doucement, l'un après l'autre */
  .js .hero-in {
    animation: rise 1s var(--ease-out) both;
    animation-delay: calc(var(--i, 0) * 110ms + 80ms);
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(0.45em);
    }
  }

  /* Le titre sort de son masque, ligne par ligne */
  .js .hero-title .hero-in {
    animation: rise-line 1.15s cubic-bezier(0.19, 1, 0.22, 1) both;
    animation-delay: calc(var(--i, 0) * 120ms + 60ms);
  }

  @keyframes rise-line {
    from {
      transform: translateY(108%);
    }
  }

  /* ——— Téléphone ——— */
  .hero-visual {
    display: grid;
    justify-items: center;
  }

  .phone-stage {
    --s: 1;
    --rx: 0deg;
    --ry: 0deg;
    position: relative;
    width: 332px;
    height: 668px;
    flex: none;
    transform: perspective(1400px) rotateX(var(--rx)) rotateY(var(--ry)) scale(var(--s));
    transition: transform 0.9s var(--ease-out);
  }

  .phone-stage [data-fil='10'] {
    left: 50%;
    top: 62%;
  }

  .fil-hero-exit {
    left: 8px;
    top: 90%;
  }

  .fil-hero-exit-d {
    left: -36px;
    top: 84%;
  }

  .fil-hero-knot {
    left: 46%;
    bottom: 64px;
  }

  .fil-hero-end {
    left: 20%;
    bottom: 0;
  }

  .stitch {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .stitch-line {
    fill: none;
    stroke: var(--amber);
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-dasharray: 7 7;
  }

  .stitch-reveal {
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
  }

  .js .stitch-reveal {
    stroke-dashoffset: 1;
  }

  .js .is-sewing .stitch-reveal {
    animation: sew 1.4s cubic-bezier(0.45, 0, 0.2, 1) forwards;
  }

  :global(.reduced) .stitch-reveal {
    stroke-dashoffset: 0;
  }

  @keyframes sew {
    from {
      stroke-dashoffset: 1;
    }
    to {
      stroke-dashoffset: 0;
    }
  }

  .stitch-needle circle {
    fill: var(--amber);
    stroke: var(--paper);
    stroke-width: 2;
  }

  .js .stitch-needle {
    opacity: 0;
  }

  .js .is-sewing .stitch-needle {
    opacity: 1;
    transition: opacity 0.2s;
  }

  /* L'aiguille ouvre les yeux une fois la couture terminée, puis cligne de temps en temps. */
  .needle-eyes {
    fill: var(--night);
    transform-box: fill-box;
    transform-origin: center;
    transform: scaleY(0.1);
  }

  .is-sewing .needle-eyes {
    animation: wake 0.4s 1.45s var(--ease-spring) forwards;
  }

  .needle-eyes ellipse {
    transform-box: fill-box;
    transform-origin: center;
    animation: blink 5s 3.2s infinite;
  }

  @keyframes wake {
    to {
      transform: scaleY(1);
    }
  }

  @keyframes blink {
    0%,
    94%,
    100% {
      transform: scaleY(1);
    }
    97% {
      transform: scaleY(0.1);
    }
  }

  .phone {
    position: absolute;
    left: 16px;
    top: 16px;
    width: 300px;
    height: 636px;
    padding: 10px;
    border-radius: 48px;
    background: linear-gradient(145deg, #233259, var(--night) 55%, #0f1830);
    box-shadow:
      inset 0 0 0 1.5px rgb(255 255 255 / 0.08),
      0 2px 3px rgb(22 33 62 / 0.12),
      0 40px 80px -30px rgb(22 33 62 / 0.55),
      0 18px 30px -18px rgb(22 33 62 / 0.4);
    z-index: 2;
  }

  :global([data-tier='high']) .phone,
  :global([data-tier='mid']) .phone {
    animation: float 7s ease-in-out infinite;
  }

  @keyframes float {
    50% {
      transform: translateY(-7px);
    }
  }

  .phone-screen {
    position: relative;
    height: 100%;
    overflow: hidden;
    border-radius: 38px;
    background: #fdfcf9;
    color: #1c2333;
  }

  .phone-screen::before {
    content: '';
    position: absolute;
    top: 10px;
    left: 50%;
    width: 84px;
    height: 24px;
    transform: translateX(-50%);
    border-radius: 999px;
    background: #0d1427;
    z-index: 3;
  }

  .status {
    position: relative;
    z-index: 2;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 14px 26px 0 30px;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.01em;
  }

  .status-icons {
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }

  .status-icons i {
    width: 4px;
    height: 9px;
    border-radius: 2px;
    background: currentColor;
  }

  .status-icons i:first-child {
    height: 6px;
  }

  .status-icons b {
    width: 22px;
    height: 11px;
    margin-left: 4px;
    border-radius: 4px;
    border: 1.5px solid currentColor;
    box-shadow: inset 0 0 0 1.5px #fdfcf9;
    background: currentColor;
  }

  .persona {
    position: absolute;
    inset: 46px 0 0;
    display: flex;
    flex-direction: column;
    padding: 0 18px;
    visibility: hidden;
  }

  .persona.is-active {
    visibility: visible;
  }

  .persona > * {
    opacity: 0;
    transform: translateY(10px);
    transition:
      opacity 0.35s ease,
      transform 0.35s ease;
  }

  .persona.is-active > *,
  .persona.is-active .agenda li {
    opacity: 1;
    transform: none;
    transition:
      opacity 0.7s var(--ease-out),
      transform 0.7s var(--ease-out);
    transition-delay: calc(var(--d, 0) * 70ms + 120ms);
  }

  .persona .agenda {
    opacity: 1;
    transform: none;
  }

  .agenda li {
    opacity: 0;
    transform: translateY(10px);
  }

  .app-bar {
    display: flex;
    align-items: center;
    gap: 9px;
    margin-top: 10px;
  }

  .app-icon {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 9px;
    background: var(--accent);
    color: #fff;
    font-family: var(--serif);
    font-size: 19px;
  }

  .app-name {
    flex: 1;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .app-avatar {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: var(--accent-soft);
    color: var(--accent);
    font-size: 13px;
    font-weight: 700;
  }

  .greet {
    margin: 20px 0 0;
    font-size: 27px;
    line-height: 1.05;
  }

  .f-serif .greet {
    font-family: var(--serif);
    font-size: 31px;
  }

  .f-serif .app-name {
    font-family: var(--serif);
    font-size: 17px;
    font-weight: 400;
  }

  .f-grotesk .greet {
    font-weight: 750;
    letter-spacing: -0.04em;
  }

  .f-rounded .greet,
  .f-rounded .app-name {
    font-family: ui-rounded, 'SF Pro Rounded', 'Nunito', 'Quicksand', var(--sans);
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .date {
    margin: 4px 0 0;
    font-size: 13px;
    color: #646d82;
  }

