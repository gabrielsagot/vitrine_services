---
import Mark from './Mark.astro';
import Icon from './Icon.astro';
import { pitch, site } from '../config/site';

const year = new Date().getFullYear();
---

<footer class="foot" data-sticky-hide aria-labelledby="foot-title">
  <!-- Trame de fond discrète façon atelier -->
  <div class="foot-mesh" aria-hidden="true"></div>

  <div class="wrap foot-wrap">
    <!-- En-tête : signature et invitation finale -->
    <div class="foot-hero">
      <div class="foot-hero-main">
        <a href="/" class="foot-brand" aria-label="Retour au sommet">
          <Mark size={32} />
          <span class="foot-brand-name">{site.brand.name}</span>
          <span class="foot-brand-tag">{site.brand.tagline}</span>
        </a>
        <h2 id="foot-title" class="foot-pitch">
          Votre quotidien, <em>sur mesure.</em>
        </h2>
        <p class="foot-sub">{pitch.subtitle}</p>
      </div>

      <div class="foot-hero-action">
        <a class="btn btn--amber" href="#contact">
          <span>{pitch.cta}</span>
          <span class="btn-pearl" aria-hidden="true"></span>
        </a>
        <p class="foot-cta-note">
          <Icon name="check" size={15} stroke={2.2} />
          <span>{pitch.ctaNote}</span>
        </p>
      </div>
    </div>

    <!-- Grille principale à 4 colonnes structurées -->
    <div class="foot-grid">
      <!-- Col 1 : L'atelier & disponibilité -->
      <div class="foot-col foot-col--intro">
        <p class="foot-col-label">L'Atelier</p>
        <p class="foot-col-desc">
          Conception & réalisation d'interfaces sur mesure (PWA) pour artisans, indépendants et
          professionnels. Chaque application est cousue main, pensée pour votre métier.
        </p>
        <div class="foot-status" aria-label="Disponibilité actuelle">
          <span class="status-dot" aria-hidden="true"></span>
          <span>Disponible pour de nouveaux projets</span>
        </div>
      </div>

      <!-- Col 2 : Parcours -->
      <nav class="foot-col" aria-label="Navigation du site">
        <p class="foot-col-label">Parcours</p>
        <ul class="foot-list">
          <li>
            <a href="#demo-tournee">La tournée optimisée</a>
          </li>
          <li>
            <a href="#services">Ce que je peux faire</a>
          </li>
          <li>
            <a href="#realisation">Une réalisation sur le terrain</a>
          </li>
          <li>
            <a href="#etapes">Comment ça se passe</a>
          </li>
          <li>
            <a href="#atelier">L'Atelier interactif</a>
          </li>
          <li>
            <a href="#a-propos">Qui je suis</a>
          </li>
        </ul>
      </nav>

      <!-- Col 3 : Contact direct -->
      <div class="foot-col">
        <p class="foot-col-label">Contact direct</p>
        <ul class="foot-list">
          <li>
            <a href={`mailto:${site.contact.email}`} class="foot-contact-item">
              <Icon name="mail" size={16} />
              <span>{site.contact.email}</span>
            </a>
          </li>
          <li>
            <a href={`tel:${site.contact.phoneE164}`} class="foot-contact-item">
              <Icon name="phone" size={16} />
              <span>+33 7 69 95 04 36</span>
            </a>
          </li>
          <li>
            <a
              href={`https://wa.me/${site.contact.phoneE164.replace('+', '')}`}
              target="_blank"
              rel="noopener"
              class="foot-contact-item"
            >
              <Icon name="whatsapp" size={16} />
              <span>WhatsApp direct</span>
            </a>
          </li>
          <li>
            <a href="#contact" class="foot-contact-item">
              <Icon name="message" size={16} />
              <span>Formulaire de devis</span>
            </a>
          </li>
        </ul>
      </div>

      <!-- Col 4 : Engagements qualité -->
      <div class="foot-col">
        <p class="foot-col-label">Engagements</p>
        <ul class="foot-commitments">
          <li>
            <Icon name="check" size={15} stroke={2.4} />
            <span>100 % sur mesure, zéro modèle générique</span>
          </li>
          <li>
            <Icon name="check" size={15} stroke={2.4} />
            <span>Fonctionne hors-ligne sur mobile</span>
          </li>
          <li>
            <Icon name="check" size={15} stroke={2.4} />
            <span>Zéro cookie, aucun traceur tiers</span>
          </li>
          <li>
            <Icon name="check" size={15} stroke={2.4} />
            <span>Hébergement souverain à Paris</span>
          </li>
        </ul>
      </div>
    </div>

    <!-- Ligne inférieure : mentions légales, espace admin et retour en haut -->
    <div class="foot-bottom">
      <div class="foot-legal">
        <span class="foot-copy">
          © {year} {site.owner.fullName}. Fait main en France.
        </span>
        <span class="foot-sep" aria-hidden="true">
          ·
        </span>
        <a href="/mentions-legales">Mentions légales</a>
        <span class="foot-sep" aria-hidden="true">
          ·
        </span>
        <a href="/confidentialite">Confidentialité</a>
        <span class="foot-sep" aria-hidden="true">
          ·
        </span>
        <a href="/admin" class="foot-admin">
          <span>Espace admin</span>
        </a>
      </div>

      <a href="#contenu" class="foot-top" aria-label="Remonter en haut de la page">
        <span>Haut de page</span>
        <svg viewBox="0 0 20 20" width="15" height="15" aria-hidden="true">
          <path
            d="M10 16V4M4 10l6-6 6 6"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
      </a>
    </div>
  </div>
</footer>

<style>
  .foot {
    position: relative;
    z-index: 2;
    padding: 72px 0 120px;
    background: var(--night);
    color: var(--on-night);
    overflow: hidden;
    border-top: 1px solid rgb(255 255 255 / 0.08);
  }

  /* Trame fine en filigrane */
  .foot-mesh {
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0.04;
    background-image:
      linear-gradient(to right, #ffffff 1px, transparent 1px),
      linear-gradient(to bottom, #ffffff 1px, transparent 1px);
    background-size: 32px 32px;
  }

  .foot-wrap {
    position: relative;
    z-index: 2;
  }

  /* ——— En-tête du footer ——— */
  .foot-hero {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 32px;
    padding-bottom: 48px;
    border-bottom: 1px solid rgb(255 255 255 / 0.08);
  }

  .foot-hero-main {
    max-width: 38em;
  }

  .foot-brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: var(--cream);
    margin-bottom: 16px;
  }

  .foot-brand-name {
    font-family: var(--serif);
    font-size: 24px;
    letter-spacing: -0.01em;
  }

  .foot-brand-tag {
    font-size: 13px;
    color: var(--on-night-soft);
    padding-left: 8px;
    border-left: 1px solid rgb(255 255 255 / 0.16);
  }

  .foot-pitch {
    margin: 0;
    font-family: var(--serif);
    font-size: clamp(34px, 5.5vw, 48px);
    font-weight: 400;
    line-height: 1.08;
    color: var(--cream);
    letter-spacing: -0.02em;
  }

  .foot-pitch em {
    font-style: italic;
    color: var(--amber);
  }

  .foot-sub {
    margin: 12px 0 0;
    font-size: 17px;
    line-height: 1.5;
    color: var(--on-night-soft);
  }

  .foot-hero-action {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
  }

  .foot-cta-note {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    margin: 0;
    font-size: 13.5px;
    color: var(--on-night-soft);
  }

  .foot-cta-note :global(svg) {
    color: var(--amber);
  }

  /* ——— Grille principale ——— */
  .foot-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 40px 32px;
    padding: 48px 0;
    border-bottom: 1px solid rgb(255 255 255 / 0.08);
  }

  .foot-col-label {
    margin: 0 0 16px;
    font-size: 11.5px;
    font-weight: 650;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--amber);
  }

  .foot-col-desc {
    margin: 0;
    font-size: 14.5px;
    line-height: 1.6;
    color: var(--on-night-soft);
  }

  .foot-status {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    margin-top: 18px;
    padding: 6px 13px;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.04);
    border: 1px solid rgb(255 255 255 / 0.08);
    font-size: 12.5px;
    color: var(--cream);
  }

  .status-dot {
    position: relative;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #48bb78;
    box-shadow: 0 0 0 2px rgb(72 187 120 / 0.2);
  }

  .foot-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 11px;
  }

  .foot-list a {
    color: var(--on-night-soft);
    font-size: 14.5px;
    text-decoration: none;
    transition:
      color 0.2s,
      transform 0.2s;
    display: inline-block;
  }

  .foot-list a:hover {
    color: var(--cream);
    transform: translateX(2px);
  }

  .foot-contact-item {
    display: inline-flex !important;
    align-items: center;
    gap: 10px;
  }

  .foot-contact-item :global(svg) {
    color: var(--amber);
    opacity: 0.85;
    flex: none;
  }

  .foot-commitments {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 11px;
    font-size: 14px;
    color: var(--on-night-soft);
  }

  .foot-commitments li {
    display: flex;
    align-items: flex-start;
    gap: 9px;
    line-height: 1.4;
  }

  .foot-commitments :global(svg) {
    color: var(--amber);
    flex: none;
    margin-top: 2px;
  }

  /* ——— Barre inférieure ——— */
  .foot-bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding-top: 28px;
    font-size: 13.5px;
    color: var(--on-night-soft);
  }

  .foot-legal {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 14px;
  }

  .foot-legal a {
    color: inherit;
    text-decoration: none;
    transition: color 0.2s;
  }

  .foot-legal a:hover {
    color: var(--cream);
  }

  .foot-sep {
    opacity: 0.35;
  }

  .foot-admin {
    padding: 2px 8px;
    border-radius: 6px;
    background: rgb(255 255 255 / 0.05);
    border: 1px solid rgb(255 255 255 / 0.08);
    font-size: 12px;
  }

  .foot-top {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    color: var(--on-night-soft);
    text-decoration: none;
    font-size: 13px;
    padding: 6px 14px;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.04);
    border: 1px solid rgb(255 255 255 / 0.08);
    transition:
      color 0.2s,
      border-color 0.2s,
      background-color 0.2s;
  }

  .foot-top:hover {
    color: var(--cream);
    border-color: rgb(255 255 255 / 0.2);
    background: rgb(255 255 255 / 0.08);
  }

  @media (min-width: 960px) {
    .foot {
      padding-top: 96px;
      padding-bottom: 72px;
    }

    .foot-grid {
      grid-template-columns: 1.3fr 1fr 1.1fr 1.1fr;
    }
  }

  @media (max-width: 768px) {
    .foot-hero {
      flex-direction: column;
      align-items: flex-start;
      gap: 24px;
    }

    .foot-bottom {
      flex-direction: column;
      align-items: flex-start;
      gap: 18px;
    }
  }
</style>
