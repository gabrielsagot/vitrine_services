---
import Mark from './Mark.astro';
import { pitch, site } from '../config/site';
const year = new Date().getFullYear();
---

<footer class="foot" data-sticky-hide>
  <div class="wrap foot-inner">
    <p class="foot-pitch">
      <Mark size={30} /> {pitch.title}
    </p>
    <p class="foot-made">Ce site est fait main, comme vos futures applications.</p>
    <nav class="foot-links" aria-label="Informations légales">
      <a href="/mentions-legales">Mentions légales</a>
      <a href="/confidentialite">Confidentialité</a>
      <span>
        © {year} {site.brand.name}
      </span>
    </nav>
  </div>
</footer>

<style>
  .foot {
    position: relative;
    z-index: 2;
    padding: 56px 0 120px;
    background: var(--night);
    color: var(--on-night);
  }

  .foot-inner {
    display: grid;
    gap: 14px;
  }

  .foot-pitch {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 0;
    font-family: var(--serif);
    font-size: clamp(34px, 8vw, 54px);
    line-height: 1.05;
    color: var(--cream);
  }

  .foot-made {
    margin: 0;
    font-family: var(--serif);
    font-style: italic;
    font-size: 21px;
    color: var(--on-night-soft);
  }

  .foot-links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 22px;
    margin-top: 18px;
    font-size: 15px;
    color: var(--on-night-soft);
  }

  .foot-links a {
    text-decoration: none;
  }

  .foot-links a:hover {
    color: var(--cream);
    text-decoration: underline;
  }

  @media (min-width: 960px) {
    .foot {
      padding-bottom: 64px;
    }
  }
</style>
