---
import { iconPaths, type IconName } from '../lib/icons';

interface Props {
  name: IconName;
  size?: number;
  stroke?: number;
  class?: string;
}

const { name, size = 24, stroke = 1.7, class: className } = Astro.props;
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={stroke}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  <path d={iconPaths[name]}></path>
</svg>
