---
import Legal from '../layouts/Legal.astro';
import { buildStroke, strokePath } from '../lib/calligraphy';
import { catmullRom, resample } from '../lib/geometry';
export const prerender = true;

// Le fil qui s'emmêle puis s'arrête, calculé une fois à la compilation : aucun script dans la page.
const points = [
  { x: 8, y: 74 },
  { x: 58, y: 46 },
  { x: 104, y: 80 },
  { x: 150, y: 56 },
  { x: 178, y: 30 },
  { x: 202, y: 54 },
  { x: 180, y: 82 },
  { x: 156, y: 62 },
  { x: 190, y: 44 },
  { x: 236, y: 74 },
  { x: 282, y: 59 },
];
const thread = strokePath(
  buildStroke(resample(catmullRom(points, 18), 2), {
    min: 1.3,
    max: 4.6,
    nib: -0.65,
    taperStart: 50,
    taperEnd: 8,
  }),
);
---

<Legal title="Le fil s'est perdu." description="Cette page n'existe pas.">
  <p>Cette page n'existe pas, ou plus. Le plus simple est de repartir de l'accueil.</p>
  <svg class="lost" viewBox="0 0 320 110" aria-hidden="true" focusable="false">
    <path d={thread} fill="var(--night)" opacity="0.92"></path>
    <g transform="translate(290 58)">
      <circle r="9" fill="var(--amber)"></circle>
      <g class="lost-eyes">
        <ellipse cx="-3" cy="-0.5" rx="1.3" ry="2"></ellipse>
        <ellipse cx="3" cy="-0.5" rx="1.3" ry="2"></ellipse>
      </g>
    </g>
  </svg>
</Legal>

<style>
  .lost {
    display: block;
    width: min(100%, 420px);
    height: auto;
    margin-top: 28px;
  }

  /* La perle cherche son chemin : elle regarde à gauche, à droite, et cligne des yeux. */
  .lost-eyes {
    fill: var(--night);
    animation: look 4.8s ease-in-out infinite;
  }

  .lost-eyes ellipse {
    transform-box: fill-box;
    transform-origin: center;
    animation: blink 4.8s infinite;
  }

  @keyframes look {
    0%,
    18%,
    100% {
      transform: translateX(0);
    }
    28%,
    44% {
      transform: translateX(-2.6px);
    }
    56%,
    74% {
      transform: translateX(2.6px);
    }
  }

  @keyframes blink {
    0%,
    86%,
    100% {
      transform: scaleY(1);
    }
    90% {
      transform: scaleY(0.1);
    }
  }
</style>
