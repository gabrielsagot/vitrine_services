---
import Base from '../layouts/Base.astro';
import Mark from '../components/Mark.astro';
import Admin from '../islands/admin/Admin';
import { site } from '../config/site';
export const prerender = true;
---

<Base title={`Espace admin · ${site.brand.name}`} description="Espace privé." noindex>
  <main id="contenu" class="wrap admin-page">
    <header class="admin-head">
      <a href="/" class="admin-brand">
        <Mark size={30} /> {site.brand.name}
      </a>
      <h1>Espace admin</h1>
    </header>
    <Admin client:only="preact" />
  </main>
</Base>

<style>
  .admin-page {
    padding-top: 24px;
    padding-bottom: 80px;
  }

  .admin-head {
    margin-bottom: 24px;
  }

  .admin-brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--serif);
    font-size: 24px;
    text-decoration: none;
  }

  h1 {
    margin: 18px 0 0;
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(40px, 9vw, 64px);
    line-height: 1;
  }
</style>
