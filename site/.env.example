# Copier ce fichier en `.env` pour le développement local (il n'est jamais enregistré dans Git).
# Sans ces valeurs, le site tourne en « mode démo » : liens de parrainage d'exemple
# (/sylvie, /marc) et demandes de contact simulées (rien n'est enregistré ni envoyé).

# Adresse publique du site (sert aux aperçus de lien)
PUBLIC_SITE_URL=https://exemple.fr

# Supabase : URL du projet et clé publique (« publishable »), utilisées par l'espace admin
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Clé secrète (service_role) : uniquement côté serveur (Vercel), JAMAIS dans le navigateur
SUPABASE_SERVICE_ROLE_KEY=

# Alerte par e-mail (https://resend.com, offre gratuite)
RESEND_API_KEY=
CONTACT_EMAIL_TO=
CONTACT_EMAIL_FROM=

# Notification sur le téléphone (https://ntfy.sh, gratuit) : un nom de sujet long et impossible à deviner
NTFY_TOPIC=
NTFY_TOKEN=
